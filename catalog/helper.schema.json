{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helpers-hub.local/schemas/helper.schema.json",
  "title": "Helpers Hub catalog item",
  "type": "object",
  "required": ["id", "category", "summary", "signature", "priority", "examples", "edge_cases", "status", "tags"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "category": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "summary": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "minLength": 1 },
    "priority": { "type": "integer", "minimum": 1, "maximum": 3 },
    "examples": { "type": "array", "items": { "type": "object", "required": ["in", "out"] } },
    "edge_cases": { "type": "array", "items": { "type": "string" } },
    "status": {
      "type": "object",
      "required": ["js", "csharp"],
      "properties": {
        "js": { "enum": ["done", "todo", "wip", "builtin", "n/a"] },
        "csharp": { "enum": ["done", "todo", "wip", "builtin", "n/a"] }
      },
      "additionalProperties": false
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "additionalProperties": false
}
